  m_Name: 
  m_EditorClassIdentifier: 
  _content:
    Title: "\u041C\u043E\u0434\u0443\u043B\u044C \xAB\u0412\u0435\u0435\u0440\xBB"
    Subtitle: "\u0414\u043B\u044F \u0433\u043D\u0435\u0437\u0434\u0430 \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u0430"
    Accent: {r: 0.83, g: 0.66, b: 0.39, a: 1}
    Tags:
    - "\u0441\u043D\u0430\u0440\u044F\u0434\u044B"
    - "\u043E\u0433\u043E\u043D\u044C"
    - "\u044F\u0434"
    - "\u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u044B\u0439 \u0443\u0440\u043E\u043D"
    - "\u043E\u0431\u043B\u0430\u0441\u0442\u044C"
    - "\u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430"
    Intrinsic: 
    Properties:
    - "+2 \u0441\u043D\u0430\u0440\u044F\u0434\u0430 \u0432\u0435\u0435\u0440\u043E\u043C"
    - "+1 \u043F\u043E\u0434\u0436\u043E\u0433"
    - "\xD71,5 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E\u0433\u043E
      \u0443\u0440\u043E\u043D\u0430"
    Triggers:
    - "\u041F\u0440\u0438 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0435
      \u2192 \u0443\u0441\u0438\u043B\u0438\u0442\u044C \u0434\u0432\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445
      \u0433\u043D\u0435\u0437\u0434\u0430."
    - "\u042D\u0442\u0430 \u0441\u0435\u043A\u0446\u0438\u044F \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u0440\u0438\u0433\u0433\u0435\u0440\u043E\u0432."
