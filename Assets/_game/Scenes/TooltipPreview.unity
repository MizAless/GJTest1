  m_Script: {fileID: 11500000, guid: dec39b78a18c411c9357ea3463bd8069, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _content:
    Title: "\u0420\u0430\u0437\u0433\u043E\u043D\u043D\u0430\u044F \u043F\u0443\u043B\u044F"
    Subtitle: "\u042D\u043F\u0438\u0447\u0435\u0441\u043A\u0438\u0439"
    Accent: {r: 0.79, g: 0.61, b: 0.92, a: 1}
    Tags:
    - "\u0441\u043D\u0430\u0440\u044F\u0434\u044B"
    - "\u043E\u0447\u0435\u0440\u0435\u0434\u044C"
    - "\u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430"
    Intrinsic: "\u041F\u0440\u0438 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0435
      \u0434\u0430\u0451\u0442 <color=#F3D191>+2 \u043A \u043E\u0447\u0435\u0440\u0435\u0434\u0438</color>
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043F\u0443\u043B\u0435."
    Properties:
    - "\xD71,5 \u0443\u0440\u043E\u043D\u0430 \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u0432"
    - "+1 \u043A \u0440\u0438\u043A\u043E\u0448\u0435\u0442\u0443"
    Triggers:
    - "\u041F\u0440\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0435 \u2192
      \u0437\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u044D\u0444\u0444\u0435\u043A\u0442
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043F\u0443\u043B\u0438."
